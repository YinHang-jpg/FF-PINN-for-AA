# .gitignore — track source and reviewer materials; ignore caches and heavy artifacts

# ---- Generated media / binaries ----
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
*.tiff
*.ico
*.pdf
*.mph

# Keep the COMSOL validation project used in the manuscript
!FEM_validation.mph

# Manuscript figure outputs
!figures/
!figures/**

# ---- Data / model artifacts ----
*.csv
*.dat
*.npz
*.npy
*.pkl
*.pickle
*.h5
*.hdf5
*.pth
*.pt
*.ckpt
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# ---- Caches / environments ----
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.sublime-*

# ---- Notebooks / office drafts (manuscript lives outside the tracked code tree) ----
*.ipynb
*.doc
*.docx

# ---- Heavy output trees (scripts under results/ are re-included below) ----
PINN/
PINN_wide/
DEM_plots/
density_plots/
data/

# ---- Re-include source and reviewer materials ----
!requirements.txt
!README.md
!.gitignore
!review/
!review/**
!scripts/
!scripts/**
!scripts/figures/data/
!scripts/figures/data/**
!results/**/*.py
!results/**/*.md
!validation/**/*.py
!validation/comsol_positions.csv
!other_files/computation_time_comparison.csv
!other_files/computation_time_comparision_particle.csv
!other_files/**/*.py
!other_files/**/*.md
!other_files/**/*.txt
!mechanisms/**/*.py
!initialization/**/*.py
!front_page/
!front_page/**

# Figure-plot caches required for offline reproduction
!results/RFF/fourier_M_panel_cd.npz
!results/kernel/panel_a_curves.npz
!results/kernel/panel_c_heatmaps.npz
!results/kernel/kernel_mednikov_polydisperse.json
!results/parameter_sweep/fig10_concentration_curves.npz
!results/parameter_sweep/aggregation_metrics_100cycles.csv
!results/parameter_sweep/aggregation_metrics_1000cycles.csv
!results/particle_distribution/displacement_vs_frequency_multi_spl.csv
!results/PD_vs_time/pinn_particle_positions.csv
!results/PD_vs_time/dem_particle_distribution_data.csv
!results/PD_vs_time/fem_particle_positions.csv
!results/Fig7/data/
!results/Fig7/data/**
!results/density_sweep/*.txt
!results/RFF/*.json
!results/Appendix_A/compare_kernel_heatmaps.npz
!results/Appendix_A/literature_kernel_comparison.json
!results/Appendix_A/compare_kernel_heatmaps.json

# Bytecode under whitelisted trees
review/**/__pycache__/
scripts/**/__pycache__/
results/**/__pycache__/
**/__pycache__/
**/*.pyc

# Keep the reviewer demo figure
!review/examples/density_comparison_t0.01s.png
!review/examples/*.json
!review/examples/*.txt
!review/examples/*.py
!review/examples/*.md
!review/*.md
